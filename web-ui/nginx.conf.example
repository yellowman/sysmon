# Nginx configuration for sysmon-web
# Copy to /etc/nginx/sites-available/sysmon-web
# Enable with: ln -s /etc/nginx/sites-available/sysmon-web /etc/nginx/sites-enabled/
# Test with: nginx -t
# Reload with: systemctl reload nginx

server {
    listen 80;
    server_name sysmon.example.com;

    # Redirect to HTTPS (recommended)
    # return 301 https://$server_name$request_uri;

    # Or serve directly over HTTP (not recommended for production)
    location / {
        include fastcgi_params;
        fastcgi_pass unix:/var/run/sysmon-web.sock;

        # Optional: Basic authentication
        # auth_basic "Sysmon Administration";
        # auth_basic_user_file /etc/nginx/.htpasswd;
    }

    location /static/ {
        alias /usr/local/libexec/sysmon-web/static/;
        expires 1h;
        add_header Cache-Control "public, immutable";
    }

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;

    # Logging
    access_log /var/log/nginx/sysmon-web-access.log;
    error_log /var/log/nginx/sysmon-web-error.log;
}

# HTTPS configuration (recommended)
server {
    listen 443 ssl http2;
    server_name sysmon.example.com;

    # SSL certificate (replace with your own)
    ssl_certificate /etc/ssl/certs/sysmon.example.com.crt;
    ssl_certificate_key /etc/ssl/private/sysmon.example.com.key;

    # SSL configuration
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # Optional: Client certificate authentication
    # ssl_client_certificate /etc/ssl/certs/ca.crt;
    # ssl_verify_client on;

    location / {
        include fastcgi_params;
        fastcgi_pass unix:/var/run/sysmon-web.sock;

        # Optional: Basic authentication (additional layer)
        # auth_basic "Sysmon Administration";
        # auth_basic_user_file /etc/nginx/.htpasswd;

        # Optional: IP whitelist
        # allow 192.168.1.0/24;
        # allow 10.0.0.0/8;
        # deny all;
    }

    location /static/ {
        alias /usr/local/libexec/sysmon-web/static/;
        expires 1h;
        add_header Cache-Control "public, immutable";
    }

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Logging
    access_log /var/log/nginx/sysmon-web-access.log;
    error_log /var/log/nginx/sysmon-web-error.log;
}
