[Unit]
Description=Sysmon Web Configuration Manager
Documentation=file:///usr/local/libexec/sysmon-web/README.md
After=network.target sysmond.service
Requires=sysmond.service

[Service]
Type=simple
User=www-data
Group=www-data
# -foreground: don't self-daemonize, so systemd (Type=simple) tracks the
#   process directly. sysmon-web daemonizes by default when run by hand.
# Add -debug to send logs to the journal while troubleshooting.
# Running as User/Group=www-data means the socket is already owned by the
# web server's user, so -socket-user/-socket-group aren't needed here.
ExecStart=/usr/local/bin/sysmon-web \
  -foreground \
  -socket /var/run/sysmon-web.sock \
  -config /etc/sysmon.conf \
  -sysmon localhost:3333 \
  -templates /usr/local/libexec/sysmon-web/templates \
  -backups /var/backups/sysmon \
  -audit /var/log/sysmon-web-audit.log
Restart=always
RestartSec=5

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# /var/lib/sysmon holds the bbolt stores (auth.db, push.db, settings.db);
# without it here ProtectSystem=strict would make them read-only.
ReadWritePaths=/var/run /var/lib/sysmon /var/backups/sysmon /var/log /etc/sysmon.conf
StateDirectory=sysmon

[Install]
WantedBy=multi-user.target
