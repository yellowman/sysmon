[Unit]
Description=Sysmon Web Configuration Manager
Documentation=https://github.com/yellowman/sysmon/blob/main/docs/WEB_DEPLOYMENT.md
# No dependency on sysmond.service: monitoring boxes dial in to this
# process over the agent port, so the usual deployment has no sysmond
# on this host at all. Running one locally works with or without an
# ordering between the two.
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
# -foreground: don't self-daemonize, so systemd (Type=simple) tracks the
#   process directly, and normal logs flow to the journal. -debug adds
#   verbose diagnostics on top; it is not the price of having logs.
# Running as User/Group=www-data means the socket is already owned by the
# web server's user, so -socket-user/-socket-group aren't needed here.
#
# The ExecStartPre lines (run as root via "+") prepare every path the
# unprivileged process cannot create for itself. The binary's own
# root-time directory preparation runs only when it STARTS as root;
# under User=www-data it never does, so the unit has to do it:
#   /var/www/run                     the FastCGI socket's directory
#   /var/backups/sysmon              config backups
#   /var/log/sysmon-web-audit.log    the audit log
# (/var/lib/sysmon is StateDirectory= below, which systemd owns.)
ExecStartPre=+/bin/mkdir -p /var/www/run
ExecStartPre=+/bin/chown www-data:www-data /var/www/run
ExecStartPre=+/usr/bin/install -d -o www-data -g www-data /var/backups/sysmon
ExecStartPre=+/bin/sh -c 'touch /var/log/sysmon-web-audit.log && chown www-data:www-data /var/log/sysmon-web-audit.log'
ExecStart=/usr/local/bin/sysmon-web \
  -foreground \
  -socket /var/www/run/sysmon-web.sock \
  -config /etc/sysmon.conf \
  -templates /usr/local/libexec/sysmon-web/templates \
  -backups /var/backups/sysmon \
  -audit /var/log/sysmon-web-audit.log
Restart=always
RestartSec=5

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# /var/lib/sysmon holds the bbolt stores (auth.db, push.db, settings.db);
# /var/www/run holds the FastCGI socket. Both must be writable under
# ProtectSystem=strict.
#
# Deliberately NOT carved out: /etc. Reading /etc/sysmon.conf needs no
# exception, and editing per-box configs goes over the agent link and
# never touches this host's /etc. Saving the LOCAL config from the
# editor is the one thing this hardened unit cannot do - the save
# writes /etc/sysmon.conf.tmp and renames, which needs a writable /etc
# directory (a file-level ReadWritePaths entry cannot provide that,
# and www-data cannot write root-owned /etc anyway). To allow it,
# add a drop-in with "ReadWritePaths=-/etc" and give www-data write
# access to the file and directory - or edit the file outside the UI.
# The audit log alone, not all of /var/log: this service has no
# business writing anyone else's logs.
ReadWritePaths=/var/www/run /var/lib/sysmon /var/backups/sysmon /var/log/sysmon-web-audit.log
StateDirectory=sysmon

[Install]
WantedBy=multi-user.target
