#!/usr/bin/sysmond -c
#
# sysmon.conf.full - Comprehensive Reference Configuration
#
# This file demonstrates every configuration option available in sysmon.
# Each section shows real directives verified against the C parser (parser.l).
#
# For a simple starting point, see sysmon.conf.dist
#

root = "example-root";

# =============================================================================
# SECTION 1: GENERIC VARIABLES (set/replace)
# =============================================================================
# Variables defined with "set" are substituted via $variable_name

set oncall = "oncall@example.com";
set netadmin = "networkadmin@example.com";
set sender = "sysmon@example.com";
set subject = "Sysmon Alert: %h %s";
set pmesg = "Host %h is %s - %m";
set upcolor = "#00FF00";
set downcolor = "#FF0000";
set recentcolor = "#FFFF00";


# =============================================================================
# SECTION 2: GLOBAL CONFIG OPTIONS
# =============================================================================

# --- Timing ---
config queuetime 300;           # Seconds between checks (default: 60)
config numfailures 4;           # Failures before alerting (default: 4)
config minnumfailures 2;        # Min failures before showing in status (default: 1)
config flaptime 5;              # Minutes to show stable after recovery (default: 0)
config pageinterval 60;         # Minutes between re-alerts (default: none)

# --- Queue ---
config maxqueued 50;            # Max simultaneous checks (default: 100)

# --- DNS ---
config dnsexpire 7200;          # DNS cache TTL in seconds (default: 1500)
config dnslog 900;              # DNS cache log interval (default: 900)

# --- Logging ---
# Two forms: syslog facility or file path
config logging file;   # sysmond.log in the state directory
# config logging syslog "daemon";

# --- Status File ---
config statusfile html "/usr/local/htdocs/sysmon.html";
config showupalso;              # Show UP hosts in status file
config html refresh 30;         # HTML auto-refresh in seconds
config date "ISO";              # Date format: ISO, DEC, or strftime(3) codes
# config cssfile "/path/to/custom.css";

# --- Email ---
config sender "sysmon@example.com";
config replyto "noc@example.com";
config errorsto "noc-errors@example.com";
# config nosubject;             # Disable subject for pager gateways

# --- Security ---
config authkey "MySecretKey123";
config noheartbeat;             # Disable registration packet
config nologconnects;           # Don't log client connections

# --- SNMP Traps ---
config snmp-trap;               # Enable SNMP trap monitoring (port 162)

# --- State ---
# Check state survives a restart automatically now - no directive. It is
# kept as sysmond.state in the state directory.
#config statedir "/var/db/sysmon";
# The pidfile is sysmond.pid in the state directory - no directive.

# --- Include Files ---
# include "/etc/sysmon.d/routers.conf";
# include "/etc/sysmon.d/servers.conf";


# =============================================================================
# SECTION 3: NAMED SPAWN COMMANDS
# =============================================================================
# Placeholders: %I=IP, %U=unique_name, %h=hostname, %s=status, %w=when,
#               %t=type, %m=message, %G=group, %c=downcount, %C=upcount

spawns {
    name "sendalert" {
        command "/usr/local/bin/send-alert.sh %I %U %s %w %t";
    };

    name "pagerduty" {
        command "/usr/local/bin/pagerduty-trigger %h %s";
    };

    name "slack" {
        command "/usr/local/bin/slack-notify '%h is %s: %m'";
    };
};


# =============================================================================
# SECTION 4: BASIC MONITORING EXAMPLES
# =============================================================================

object example-root {
    ip "192.168.1.1";
    type ping;
    desc "Root object - dependency tree root";
    contact $netadmin;
};

object example-ping {
    ip "192.168.1.10";
    type ping;
    desc "Basic ping monitoring";
    dep "example-root";
    contact $netadmin;
};


# =============================================================================
# SECTION 5: PING WITH THRESHOLDS
# =============================================================================
# NOTE: rtt_threshold and jitter_threshold are configurable per-object.
# send_pings and min_pings are hardcoded defaults (not configurable).

object example-rtt {
    ip "192.168.1.20";
    type ping;
    desc "RTT latency monitoring";
    dep "example-root";
    contact $oncall;
    rtt_threshold 50;           # Alert if average RTT >50ms
};

object example-jitter {
    ip "192.168.1.21";
    type ping;
    desc "Jitter monitoring";
    dep "example-root";
    contact $oncall;
    jitter_threshold 20;        # Alert if jitter >20ms
};


# =============================================================================
# SECTION 6: TCP PORT MONITORING
# =============================================================================

object example-tcp {
    ip "192.168.1.40";
    type tcp;
    port 8080;
    desc "TCP port check";
    dep "example-root";
    contact $netadmin;
};


# =============================================================================
# SECTION 7: HTTP/HTTPS MONITORING
# =============================================================================

object example-http {
    ip "192.168.1.50";
    type http;
    desc "Basic HTTP check";
    dep "example-root";
    contact $netadmin;
};

object example-https {
    ip "192.168.1.51";
    type https;
    desc "HTTPS check";
    dep "example-root";
    contact $netadmin;
};

object example-http-content {
    ip "192.168.1.52";
    type http;
    desc "HTTP with URL path and content check";
    dep "example-root";
    contact $netadmin;
    url "/health";
    urltext "OK";               # Response body must contain "OK"
};

object example-http-header {
    ip "192.168.1.53";
    type http;
    desc "HTTP header validation";
    dep "example-root";
    contact $netadmin;
    header "X-Service-Status";
    headerval "healthy";
};


# =============================================================================
# SECTION 8: EMAIL MONITORING
# =============================================================================

object example-smtp {
    ip "192.168.1.60";
    type smtp;
    desc "SMTP server";
    dep "example-root";
    contact "mailadmin@example.com";
};

object example-pop3 {
    ip "192.168.1.61";
    type pop3;
    desc "POP3 with auth";
    dep "example-root";
    contact "mailadmin@example.com";
    username "testuser";
    password "testpass";
};

object example-imap {
    ip "192.168.1.62";
    type imap;
    desc "IMAP with auth";
    dep "example-root";
    contact "mailadmin@example.com";
    username "testuser";
    password "testpass";
};


# =============================================================================
# SECTION 9: DNS MONITORING
# =============================================================================

object example-dns {
    ip "192.168.1.70";
    type dns;
    desc "DNS server check";
    dep "example-root";
    contact $netadmin;
};

object example-dns-full {
    ip "192.168.1.71";
    type dns;
    desc "DNS with query, AA, and recursion";
    dep "example-root";
    contact $netadmin;
    dns-query "example.com";
    dns-aa;                     # Require authoritative answer
    dns-recursion;              # Use recursive query
};


# =============================================================================
# SECTION 10: SSH / RADIUS
# =============================================================================

object example-ssh {
    ip "192.168.1.80";
    type ssh;
    desc "SSH server";
    dep "example-root";
    contact $netadmin;
};

object example-radius {
    ip "192.168.1.90";
    type radius;
    desc "RADIUS server";
    dep "example-root";
    contact $netadmin;
    username "testuser";
    password "testpass";
    secret "sharedsecret";
};


# =============================================================================
# SECTION 11: SNMP MONITORING
# =============================================================================

object example-snmp-high {
    ip "192.168.1.100";
    type snmp;
    desc "SNMP CPU high threshold";
    dep "example-root";
    contact $netadmin;
    community "public";
    oid "1.3.6.1.4.1.9.2.1.56.0";
    snmp-type "high";
    snmp-high 80;
};

object example-snmp-low {
    ip "192.168.1.101";
    type snmp;
    desc "SNMP disk low threshold";
    dep "example-root";
    contact $netadmin;
    community "public";
    oid "1.3.6.1.2.1.25.2.3.1.6.1";
    snmp-type "low";
    snmp-low 1000000;
};

object example-snmp-exact {
    ip "192.168.1.102";
    type snmp;
    desc "SNMP interface status exact match";
    dep "example-root";
    contact $netadmin;
    community "public";
    oid "1.3.6.1.2.1.2.2.1.8.1";
    snmp-type "exact";
    snmp-exact 1;               # 1 = ifOperStatus up
};

object example-snmp-rate {
    ip "192.168.1.103";
    type snmp;
    desc "SNMP bandwidth rate";
    dep "example-root";
    contact $netadmin;
    community "public";
    oid "1.3.6.1.2.1.31.1.1.1.6.1";
    snmp-type "rate";
    snmp-rate 125000000;        # 1 Gbps in bytes/sec
    snmp-octets;                # Convert bytes to bits (*8)
};

object example-snmp-uptime {
    ip "192.168.1.104";
    type snmp;
    desc "SNMP uptime monitoring";
    dep "example-root";
    contact $netadmin;
    community "public";
    oid "1.3.6.1.2.1.1.3.0";
    snmp-type "uptime";
};

object example-snmp-custom-msgs {
    ip "192.168.1.105";
    type snmp;
    desc "SNMP with custom messages";
    dep "example-root";
    contact $netadmin;
    community "public";
    oid "1.3.6.1.2.1.1.3.0";
    snmp-type "uptime";
    snmp-upmsg "System running normally";
    snmp-downmsg "System uptime check failed";
};

object example-snmp-compare {
    ip "192.168.1.106";
    type snmp;
    desc "SNMP OID comparison";
    dep "example-root";
    contact $netadmin;
    community "public";
    oid "1.3.6.1.2.1.2.2.1.10.1";
    snmp-oid-sec "1.3.6.1.2.1.2.2.1.16.1";
};


# =============================================================================
# SECTION 12: SNMP TRAP MONITORING
# =============================================================================

object example-trap {
    ip "192.168.1.110";
    type ping;
    desc "Host with trap alerts";
    dep "example-root";
    contact $oncall;
    trap_alert;
};


# =============================================================================
# SECTION 13: PER-OBJECT OVERRIDES
# =============================================================================

object example-overrides {
    ip "192.168.1.120";
    type ping;
    desc "Custom intervals and thresholds";
    dep "example-root";
    contact $oncall;
    queuetime 60;               # Check every 60 seconds
    numfailures 2;              # Alert after 2 failures
    pageinterval 15;            # Re-alert every 15 minutes
    contact_on "both";          # Alert on down AND recovery
    spawn "pagerduty";
    pmesg "CRITICAL: %h is %s";
};


# =============================================================================
# SECTION 14: DEPENDENCIES, GROUPS, SPECIAL OPTIONS
# =============================================================================

object example-grouped {
    ip "192.168.1.130";
    type ping;
    desc "Grouped host";
    dep "example-root";
    contact $netadmin;
    group "production";
};

object example-reverse {
    ip "192.168.1.131";
    type ping;
    desc "Alert when UP (reverse logic)";
    dep "example-root";
    contact $netadmin;
    reverse;
};

object example-paused {
    ip "192.168.1.132";
    type ping;
    desc "Monitoring paused (maintenance)";
    dep "example-root";
    contact $netadmin;
    pause;
};


# =============================================================================
# PUSH NOTIFICATIONS (APNs / FCM)
# =============================================================================
# Push notification settings (FCM credentials, APNs cert/key, bundle id,
# enable flag) are configured in the sysmon-web admin UI and stored in
# /var/lib/sysmon/settings.db - they are not sysmond's concern.


# =============================================================================
# END OF CONFIGURATION
# =============================================================================
