# A worked example: one wireless ISP's fleet, 500 objects.
#
# Every object here was stamped out of a shipped device template - tower
# routers, PTP backhauls, PTMP sectors, subscriber radios, a PON plant,
# core and transit, and the power and environmental gear underneath all
# of it. This is what the Templates page produces when you point it at a
# real network, and it is the config behind the screenshots in the
# README.
#
# The addresses are loopback so the file can be run as-is on one machine
# for a look around. Two towers - cedar-gap and birch-summit - are on
# reserved documentation ranges that answer nothing, which is what puts
# the outage on the map.
#
# It is an example, not a starting point for your network: change the
# addresses, the contact, and the thresholds that matter to you.

root = "core-rtr-1";


# A worked example: one WISP's fleet, 500 objects, every one of them
# stamped out of a shipped device template.
config sitename "wisp";
config sitedesc "Example Wireless - production fleet";
config logging file;
config queuetime 45;
config maxqueued 120;
config dnsexpire 7200;
config numfailures 2;






object core-rtr-1 {
	ip "127.10.0.1";
	type ping;
	desc "Core router, Datacenter A";
	contact "noc@example.net";
};

object core-rtr-1-rtt {
	ip "127.10.0.1";
	type rtt;
	desc "core-rtr-1 core latency above 10ms or jitter above 3ms";
	contact "noc@example.net";
	dep "core-rtr-1";
	rtt_threshold 10;
	jitter_threshold 3;
	rtt_samples 5;
	rtt_interval 100;
};

object core-rtr-1-loss {
	ip "127.10.0.1";
	type pktloss;
	desc "core-rtr-1 any packet loss in the core";
	contact "noc@example.net";
	dep "core-rtr-1";
};

object core-rtr-1-cpu {
	ip "127.10.0.1";
	type snmp;
	desc "core-rtr-1 CPU above 80%";
	contact "noc@example.net";
	dep "core-rtr-1";
	community "public";
	oid ".1.3.6.1.2.1.25.3.3.1.2.1";
	snmp-type "high";
	snmp-high "80";
};

object core-rtr-1-uptime {
	ip "127.10.0.1";
	type snmp;
	desc "core-rtr-1 reboot watch";
	contact "noc@example.net";
	dep "core-rtr-1";
	community "public";
	oid ".1.3.6.1.2.1.1.3.0";
	snmp-type "reboot";
};

