root = "my.default.gateway-obj";
;
;;
#
# Comments can look like this
; or this

# create a file for web page users
config statusfile html "/usr/local/htdocs/index.html";
# Temp directory for building status file (writable by dropped-privilege user)
# Recommended when using "config drop_privileges" - use a directory owned by
# the nobody/daemon user (e.g., /var/run/sysmon, /tmp/sysmon)
config statustempdir "/var/run/sysmon";
# Log devices that are up/down
config logging file "/var/log/sysmond.log";
# Configure an authentication key -- Default is none
#config authkey "Debug";
# Set the sender to be sysmon@localhost
config sender "sysmon";
# Expire in-process dns cache this often
config dnsexpire 7200;
# Do not queue more than this many objects to be checked at once
config maxqueued 50;

# Who this daemon is, when several of them share one sysmon-web.
# sitename is the key: it becomes the first half of every "site:object"
# a client stores, so it is limited to letters, digits, - and _ , and
# changing it later renames everything. sitedesc is just the label a
# person reads and can be reworded any time. Unset means "local".
#config sitename "sysmon-metro";
#config sitedesc "Metro Station Monitoring (Linux)";

# Dial out to a sysmon-web rather than waiting to be dialled. This is the
# normal way to be monitored: a box usually sits behind NAT or on a
# management VLAN, so outbound-only means no inbound firewall rule per
# site - and no listening socket on this daemon at all. The token proves
# this daemon to the aggregator; the config authkey above still proves the
# aggregator to this daemon when it asks for CONF.
#
# The link is never load-bearing: if it cannot be made, or drops, checks
# and pages carry on exactly as on a standalone box and the daemon retries
# with a backoff.
#config aggregator "sysmon-web.example.net:1347";
#config aggregator-token "paste the token the admin page minted";
#config aggregator-ca "/etc/ssl/sysmon-web-agent.pem";  # sysmon-web logs where it wrote this

# Listen for the sysmon client on TCP 1345.
#
# OFF unless you ask, and that is a deliberate change: this socket was
# open on every sysmond for most of the daemon's life, unauthenticated
# until AUTH and owned by a process that ran as root. Turn it on if you
# use the sysmon(1) client against this box directly - which is the
# stand-alone way to run, and does not need a sysmon-web at all.
#
# "-p <port>" on the command line does the same and overrides this.
#config listen 1345;

# Where a sysmon-web-managed config lives on this box.
#
# THIS FILE IS NEVER WRITTEN. When a sysmon-web manages this box, the
# config it delivers is kept under the directory below - owned by the user
# sysmond drops to, created for it at startup while still root - and the
# daemon loads that instead of this file. This file stays as the operator
# wrote it, is what the box falls back to if the directory is emptied, and
# is what "Unmanage" in the UI returns the box to.
#
# Default: /var/db/sysmon, on every platform - one path to recite rather
# than one per OS. Read from THIS file only: a delivered config cannot move
# the directory the daemon is running out of.
#config generation-dir "/var/db/sysmon";

# Catch SNMP traps on UDP 162. Off by default; port 162 is privileged, so
# the socket is bound at startup while sysmond is still root - enabling
# this on a running daemon needs a restart, not a SIGHUP.
# Traps are decoded (v1 and v2c) and logged with what the device said.
# To page on them, add "trap_alert;" to the object with that IP as well.
#config snmp-trap;		# catch snmp-traps

object my.default.gateway-obj {
	ip "10.1.1.1";
	type ping;
	desc "router-eth1-1";
	dep "router";
	contact "my-email-address";
};

object router {
	ip "router-loopback0";
	type ping;
	desc "main router";
	contact "my-pager-email-address";
};

object MyHost.net {
	ip "MyHost.net";
	type ping;
	desc "MyHost";
	dep "my.default.gateway-obj";
	contact "my-pager-email-address";
};

object router2.MyNet.net {
	ip "Router2.MyNet.net";
	type ping;
	desc "wr";
	dep "my.default.gateway-obj";
	contact "my-email-address";
};

object Other.Host.org {
	ip "Other.Host.org";
	type ping;
	desc "Other.Host.org";
	dep "router2.MyNet.net";
	contact "admin@other.host.org";
};

object router-eth1-3 {
	ip "10.2.2.17";
	type ping;
	dep "router";
	desc "router-eth1-3";
	contact "networkadmin@example.com";
};


object nether.net {
	ip "nether.net";
	type ping;
	desc "nether.net";
	dep "router-eth1-3";
	contact "admin@example.com";
};

object telnet-nether.net {
	ip "nether.net";
	type tcp;
	port 23;
	dep "nether.net";
	desc "telnetd-nether.net";
	contact "admin@example.com";
};

object smtp-nether.net {
	ip "nether.net";
	type smtp;
	dep "nether.net";
	desc "smtp-nether.net";
	contact "admin@example.com";
};

object router-s2-0-0 {
	ip "169.254.0.1";
	type ping;
	desc "T1 to Upstream";
	dep "router";
	contact "admin@mynetwork.com";
};

